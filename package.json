{
  "name": "@kokoa/clotho",
  "version": "0.1.8",
  "description": "JSON-defined visualization animations — framework-agnostic scene graph with React, Vue, vanilla, and SVG-string adapters",
  "license": "MIT",
  "author": "kokoa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinkeonkim/clotho.git"
  },
  "homepage": "https://github.com/shinkeonkim/clotho#readme",
  "bugs": {
    "url": "https://github.com/shinkeonkim/clotho/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "schema",
    "docs/assets/gallery/*.gif",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "clotho": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "default": "./dist/svg/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./gif": {
      "types": "./dist/gif/index.d.ts",
      "default": "./dist/gif/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./styles.css": "./dist/clotho.css",
    "./schema.json": "./schema/clotho-1.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "typesVersions": {
    "*": {
      "svg": [
        "./dist/svg/index.d.ts"
      ],
      "dom": [
        "./dist/dom/index.d.ts"
      ],
      "react": [
        "./dist/react/index.d.ts"
      ],
      "vue": [
        "./dist/vue/index.d.ts"
      ],
      "node": [
        "./dist/node/index.d.ts"
      ],
      "gif": [
        "./dist/gif/index.d.ts"
      ],
      "plugins": [
        "./dist/plugins/index.d.ts"
      ],
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "gallery": "bun examples/gallery/index.html",
    "gallery:build": "bun examples/gallery/build.ts",
    "gallery:gifs": "bun examples/gallery/export-gifs.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:core-purity": "bun scripts/check-core-purity.ts",
    "check:styles": "bun scripts/check-styles.ts",
    "check:size": "bun scripts/check-size.ts",
    "schema:generate": "bun scripts/generate-json-schema.ts",
    "schema:check": "bun scripts/generate-json-schema.ts --check",
    "check:legacy-equivalence": "bun scripts/verify-legacy-equivalence.ts",
    "check:svg-wellformed": "bun scripts/verify-svg-wellformed.ts",
    "audit:editor": "bun scripts/audit-editor-coverage.ts",
    "release:check": "bun scripts/release-check.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "gifenc": "^1.0.3",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bun": "^1.1.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vue/server-renderer": "^3.5.41",
    "eslint": "^9.17.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vue": "^3.5.13",
    "zod-to-json-schema": "^3.25.2"
  },
  "keywords": [
    "animation",
    "visualization",
    "svg",
    "json",
    "timeline",
    "react",
    "vue",
    "framework-agnostic"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // Self-reference so examples can import the package by name and still be
      // typechecked. An example that does not compile is worse than no example.
      "@shinkeonkim/clotho": ["src/core/index.ts"],
      "@shinkeonkim/clotho/react": ["src/react/index.ts"],
      "@shinkeonkim/clotho/vue": ["src/vue/index.ts"],
      "@shinkeonkim/clotho/dom": ["src/dom/index.ts"],
      "@shinkeonkim/clotho/svg": ["src/svg/index.ts"],
      "@shinkeonkim/clotho/node": ["src/node/index.ts"],
      "@shinkeonkim/clotho/styles.css": ["src/styles/clotho.css"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "tsup.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "dist", ".private"]
}
